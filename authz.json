{
  "$schema": "https://raw.githubusercontent.com/Termix-SSH/Termix/main/scripts/authz/authz.schema.json",
  "seed": [],
  "routes": {
    "GET /plugin-api/certificates/:hostId/certificates": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "POST /plugin-api/certificates/:hostId/delete": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true
    },
    "GET /plugin-api/certificates/:hostId/inspect": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "POST /plugin-api/certificates/:hostId/install": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true
    },
    "POST /plugin-api/certificates/:hostId/issue": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "POST /plugin-api/certificates/:hostId/renew": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "POST /plugin-api/certificates/:hostId/revoke": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true
    },
    "GET /plugin-api/certificates/:hostId/status": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "POST /plugin-api/certificates/:hostId/watch": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      }
    },
    "GET /plugin-api/certificates/summary": {
      "access": "user",
      "permission": "certificates.use",
      "resource": {
        "kind": "host",
        "min": "connect",
        "key": "hostId"
      },
      "filtered": true,
      "note": "Lists only what the caller may see"
    }
  }
}
